  conditionalGreetings: []
  availableTopics:
  - topicName: You seem enthusiastic
    requiredDay: 1
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: "Well, it\u2019s almost a wonderful day."
      effect: 0
    - speaker: {fileID: 11400000}
      text: Me and my wife are having our anniversary next week.
      effect: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "Oh well, that\u2019s nice. How did the two of you meet?"
      effect: 0
    - speaker: {fileID: 11400000}
      text: Oh well it was almost five years ago at this point.
      effect: 0
    - speaker: {fileID: 11400000}
      text: "The two of us were at a mutual friend\u2019s housewarming party."
      effect: 0
    - speaker: {fileID: 11400000}
      text: ' We stood in the corner together chatting about all sorts of things.
        We had a drink bowl all to ourselves

        as well.'
      effect: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: what drink was it? Lemonade?
      effect: 0
    - speaker: {fileID: 11400000}
      text: No, but it was similar. I usually drink lemonade to remember that night
        a little bit
      effect: 0
    - speaker: {fileID: 11400000}
      text: The actual drink was pink and had a slightly suble taste to it.
      effect: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: I see...
      effect: 0
  - topicName: So, what do you do?
    requiredDay: 1
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: You seem enthusiastic
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: "\u201CI\u2019m a berry farmer. I don\u2019t live all too far from this
        place..."
      effect: 0
    - speaker: {fileID: 11400000}
      text: This place was a potion shop, right? I used to pass by it on my way to
        the general store
      effect: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Yeahhh... I got a little screwed over by the new birds in charge
      effect: 0
    - speaker: {fileID: 11400000}
      text: "Well, at least mixing drinks and mixing potions ain\u2019t all that
        different, right?"
      effect: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: you could say that.
      effect: 0
  conditionalReactions:
  - branchName: Pink Lemonade
    requiredPotions: 08000000
    requiredEffects: 
    requiredFlavors: 
    requiredStoryFlag: 
    excludedStoryFlag: 
    goldReward: 300
    reactionTopic:
