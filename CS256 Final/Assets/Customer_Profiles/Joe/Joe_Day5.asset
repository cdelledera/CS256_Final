  - branchName: PINK LEMONADE FIRST TIME
    requiredPotions: 08000000
    requiredEffects: 
    requiredFlavors: 
    requiredStoryFlags: []
    excludedStoryFlags: []
    goldReward: 300
    reactionTopic:
      topicName: 
      requiredDay: 0
