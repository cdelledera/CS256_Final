      flagsToSet: []
      requiredPreviousTopic: 
      lines:
      - speaker: {fileID: 11400000}
        text: Oh... Out of the good stuff?
        effect: 1
        bonusGold: 0
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Yeah, out of pink.
        effect: 0
        bonusGold: 0
      - speaker: {fileID: 11400000}
        text: "Ah, that\u2019s fine."
        effect: 0
        bonusGold: 0
      - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
        text: "Woah! Are you really scamming us out of the good stuff? That\u2019s
