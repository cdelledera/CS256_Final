  availableTopics:
  - topicName: So, Rachel, why are you here?
    requiredDay: 0
    requiredStoryFlags:
    - Rachel_Got_Speed
    excludedStoryFlags: []
    flagsToSet: []
    requiredPreviousTopic: 
    lines:
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: Why do you think? I saw easy money. Not to mention a nice drink and a
        good chat.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "Oh, are you looking to work here? I didn\u2019t see a help wanted sign..."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "Yeah... let\u2019s go with that. I just love the idea of sitting behind
        a failing bar all day."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "Hey, that\u2019s really not a nice thing to say!"
      effect: 3
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "Well it hasn\u2019t been great, but I wouldn\u2019t say failing..."
      effect: 0
      bonusGold: 0
  - topicName: What can I get you?
    requiredDay: 0
    requiredStoryFlags:
    - Rachel_Got_Speed
    excludedStoryFlags: []
    flagsToSet: []
    requiredPreviousTopic: So, Rachel, why are you here?
    lines:
    - speaker: {fileID: 11400000}
      text: The usual please.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "You know what? Get me this guy\u2019s usual. I\u2019m going to judge
        his taste in drinks."
      effect: 0
      bonusGold: 0
  - topicName: What have you been doing Rachel?
    requiredDay: 0
    requiredStoryFlags:
    - 
    excludedStoryFlags:
    - Rachel_Got_Speed
    flagsToSet: []
    requiredPreviousTopic: 
    lines:
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "Well, I\u2019ve been mapping out the birdhouse all day. "
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: The birdhouse? Are you insane???
      effect: 3
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "I think I found pretty much every weak spot they have... it\u2019s not
        many, but it\u2019s enough."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "I\u2019ll admit, the work has been exhausting. I could use some extra
        energy about now."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "No! We are not glossing over that, what do you mean you\u2019re mapping
        the birdhouse???\u201D"
      effect: 3
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: Enough for what? Oh, are you an insurance lady?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "Insurance? Jeez, I\u2019m not THAT much of a thief..."
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 0}
      text: "I'm sorry, I shouldn\u2019t have assumed. What do you do for a living?"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: Nothing you should be worrying about~
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: I am incredibly worried about this!
      effect: 0
      bonusGold: 0
