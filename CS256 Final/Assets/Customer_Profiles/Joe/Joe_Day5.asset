    lines:
    - speaker: {fileID: 11400000}
      text: Hello.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Back again already?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: I was just on a shopping run, so I thought I'd stop by.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Hey, Rachel
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: Yo. What's that look for?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Don't even think about it.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "Whaaat?! I wasn\u2019t thinking about anything!"
      effect: 3
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Joe, Move a seat over.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: Huh? Alright...
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "You\u2019re no fun."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: Oh! Also, I fetched a pretty good price for that item the other day.
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: What about it?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "Well, I could tell I was a bit extra charming, so here\u2019s a little
        something extra."
      effect: 0
      bonusGold: 300
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Oh, thanks!
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
      text: "If you want, you can give me another one and I can try \u201Chaggling\u201D
        with you~"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Stop.
      effect: 0
      bonusGold: 0
