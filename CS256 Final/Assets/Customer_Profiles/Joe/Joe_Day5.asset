      requiredPreviousTopic: 
      lines:
      - speaker: {fileID: 11400000}
        text: Wait... Hey this is that drink I mentioned a while back!
        effect: 1
        bonusGold: 0
      - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
        text: uh... not your usual?
        effect: 0
        bonusGold: 0
      - speaker: {fileID: 11400000}
        text: "It\u2019s a long story, but I\u2019ve been looking to get this for
          a while! What's it called?"
        effect: 0
        bonusGold: 0
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Pink lemonade.
        effect: 0
        bonusGold: 0
      - speaker: {fileID: 11400000}
        text: ... Well now I just feel silly.
        effect: 0
        bonusGold: 0
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Nah, there are a lot of-
        effect: 0
        bonusGold: 0
      - speaker: {fileID: 11400000, guid: 2b89243ca6e1b854f881316fd5e34fb9, type: 2}
        text: HAHAHAHAHAHAHAHA!!!!! What an IDIOT!
        effect: 3
        bonusGold: 0
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Rachel, be nice!
        effect: 1
        bonusGold: 0
      - speaker: {fileID: 11400000}
        text: Well aside from that, thank you for giving this to me. I appreciate
          it.
        effect: 0
        bonusGold: 0
    endInteraction: 1
