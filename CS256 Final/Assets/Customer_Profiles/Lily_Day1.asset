--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc842acf67cf0cd42bc1b2a9906b2c37, type: 3}
  m_Name: Lily_Day1
  m_EditorClassIdentifier: 
  characterName: Lily
  companion: {fileID: 0}
  greetingTopic:
    topicName: Hello
    requiredLilyState: 0
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: Morning
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "The sun is almost down.\u201D"
    - speaker: {fileID: 11400000}
      text: "Oh, I wasn\u2019t really looking up. So, how\u2019s the new business
        treating you?"
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "It\u2019s going well enough.\u201D"
  availableTopics:
  - topicName: How are you?
    requiredLilyState: 0
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "How\u2019s the adventuring now that you can't get buffed as easy?"
    - speaker: {fileID: 11400000}
      text: I quit.
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "... Lily, you know I\u2019m still-"
    - speaker: {fileID: 11400000}
      text: "I hate that your old business is illegal now, but that\u2019s not my
        issue."
    - speaker: {fileID: 11400000}
      text: "The birds completely destroyed the adventurer\u2019s guild."
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "What? How? Why?\u201D"
    - speaker: {fileID: 11400000}
      text: They halted EVERY SINGLE COMMISSION.
    - speaker: {fileID: 11400000}
      text: "Instead of actually doing anything helpful for the community, we need
        to kill \u201CThe Monster\u201D\u201D"
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "The Monster? Which one? Why the whole guild?\u201D"
    - speaker: {fileID: 11400000}
      text: I know just as much as you do. Nobody knows anything about it.
    - speaker: {fileID: 11400000}
      text: "We get paid hourly to go on what I can only assume is a snipe hunt.
        I can\u2019t deal with that."
  - topicName: How's the apartment?
    requiredLilyState: 0
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: How are you?
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: The place is the same as ever. You should come over again some time;
        I got that apple juice you like.
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "As nice as that sounds, I\u2019ve been really busy lately. Maybe next
        week."
    - speaker: {fileID: 11400000}
      text: "Sounds good. I\u2019ll warn you though, two of stalker bird\u2019s guards
        are posted outside."
    - speaker: {fileID: 11400000}
      text: They yelled at me this morning for jaywalking. JAYWALKING! There were
        no carriages coming.
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "Wow. That\u2019s ridiculous."
    - speaker: {fileID: 11400000}
      text: "I swear I need to beat them up when I get home... I\u2019m tired of
        them."
    - speaker: {fileID: 11400000}
      text: "Well let\u2019s not go too crazy..."
  - topicName: What can I get for you?
    requiredLilyState: 0
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: How's the apartment?
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: "eh, I\u2019ll go with a... You know what? I don\u2019t care; you make
        good decisions. Give me whatever."
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "Really? You\u2019re putting a whole lot of trust in me."
    - speaker: {fileID: 11400000}
      text: "Right now it\u2019s not the drink that matters, It\u2019s the real contents...
        I need to be a bit tougher tonight."
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Gotcha...
  conditionalReactions:
  - branchName: Apple Juice
    requiredPotions: 03000000
    requiredEffects: 
    requiredCategories: 
    goldReward: 200
    reactionTopic:
      topicName: Apple Juice
      requiredLilyState: 0
      requiredDay: 0
      requiredStoryFlag: 
      excludedStoryFlag: 
      requiredPreviousTopic: 
      flagToSet: 
      lines:
      - speaker: {fileID: 11400000}
        text: "Ha! I should\u2019ve known."
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: "You brought it up, I thought you\u2019d like it."
      - speaker: {fileID: 11400000}
        text: "You would be right. Here\u2019s your tip."
  - branchName: Spicy Stuff
    requiredPotions: 0900000004000000
    requiredEffects: 
    requiredCategories: 
    goldReward: 100
    reactionTopic:
      topicName: Spicy
      requiredLilyState: 0
      requiredDay: 0
      requiredStoryFlag: 
      excludedStoryFlag: 
      requiredPreviousTopic: 
      flagToSet: 
      lines:
      - speaker: {fileID: 11400000}
        text: "Well, I should\u2019ve expected this. Bottoms up!"
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: I have no idea how you do it.
      - speaker: {fileID: 11400000}
        text: "I\u2019ve been eating spicy stuff since I was a kid. This is nothing."
  defaultFailReaction:
    topicName: Thanks!
    requiredLilyState: 0
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: Thanks, have a good one!
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: You too!
