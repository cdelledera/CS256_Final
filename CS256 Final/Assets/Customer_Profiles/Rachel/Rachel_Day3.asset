    requiredStoryFlags:
    - Rachel_Day2_Fail
    - Rachel_Got_Speed
    excludedStoryFlags: []
    flagsToSet: []
    requiredPreviousTopic: 
    lines:
    - speaker: {fileID: 11400000}
      text: I'm back!
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Great. Now get out.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "Oh don\u2019t be so cold~ I\u2019m just here for a drink and chat!"
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "You didn\u2019t pay me last time."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "Well you didn\u2019t give me anything good... fine, here. We good?"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: ... Fine. Sit down.
      effect: 0
      bonusGold: 0
  - topicName: Speed Route (Success on Day 2)
    requiredDay: 0
    requiredStoryFlags:
    - Rachel_Got_Speed
    excludedStoryFlags:
    - Rachel_Day2_Fail
    flagsToSet: []
    requiredPreviousTopic: 
    lines:
