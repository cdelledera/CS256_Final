      text: "Guess who\u2019s baaaack~"
      effect: 2
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Great...
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "Oh you\u2019re no fun. Not even gonna ask about my day?"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
