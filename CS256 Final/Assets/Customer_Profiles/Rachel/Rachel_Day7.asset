      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: "You\u2019re not stealing that drink, are you?"
        effect: 1
        bonusGold: 0
      - speaker: {fileID: 11400000}
        text: No, it just gives me a reminder of what I'm going for.
        effect: 0
