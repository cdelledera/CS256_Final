  - topicName: NO SPEED
    requiredDay: 0
    requiredStoryFlags: []
    excludedStoryFlags:
    - Rachel_Got_Speed
    flagsToSet: []
    requiredPreviousTopic: 
    lines:
    - speaker: {fileID: 11400000}
      text: Hey, bartender~
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Welcome back, Rachel. How is everything?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "Oh, it\u2019s just wonderful!"
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: I have my heist planned out start to finish, I got all the equipment
        I need, now I just need to wait.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Are you really sure this is a good idea?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: I liked it when I thought you were getting a job.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "You know that\u2019s just not how I do things."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "I\u2019ll stop trying to convince you then... What are you waiting for?"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "There\u2019s gonna be a huge battle tomorrow! The perfect distraction~"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "That\u2019ll do it..."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: Anyway, can I get a drink?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Of course, what do you want?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: Get me something that will make me feel like royalty~
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Coming right up.
      effect: 0
      bonusGold: 0
