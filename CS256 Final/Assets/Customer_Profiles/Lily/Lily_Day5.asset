    lines:
    - speaker: {fileID: 11400000}
      text: I'm back.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Oh hey welcome back. How did things go yesterday?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "Well, I did get that small job from Joe. Outside of that, I couldn\u2019t
        find anything."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: My condolences... Have you tried the nursing home?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: The grannies are doing fine! I was apparently the last guild quitter
        to consider them.
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Ouch... maybe you can crash with me for a little bit... If things go
        really bad.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: Thanks...
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: caacd43d847d12f4896590de52824cb9, type: 2}
      text: Bartender.
      effect: 0
      bonusGold: 0
