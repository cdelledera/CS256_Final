  conditionalGreetings:
  - topicName: PONDERING + CHARISMA + HEALING
    requiredDay: 0
    requiredStoryFlags:
    - Lily_Pondered
    - Lily_Charisma
    - Steph_Healing
    excludedStoryFlags: []
    flagsToSet: []
    requiredPreviousTopic: 
    lines:
    - speaker: {fileID: 11400000}
      text: I return!
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Oh hey welcome back. How did things go yesterday?
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: ' Pretty well! I actually got quite a few people on board.'
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "Well that\u2019s awesome!"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: In fact, I was even given a pretty generous donation.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "I\u2019m using most of it for the guild, but you deserve a tip for your
        help."
      effect: 0
      bonusGold: 100
    - speaker: {fileID: 11400000, guid: caacd43d847d12f4896590de52824cb9, type: 2}
      text: Bartender.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Oh, hi Steph! This is my friend Lily, she-
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: caacd43d847d12f4896590de52824cb9, type: 2}
      text: "You\u2019re selling potions."
      effect: 2
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "Woah! Let\u2019s not say the P word out loud in here."
      effect: 1
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: "She\u2019s not a cop is she? Quick, get me something to drink, I\u2019ll
        take her!"
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: caacd43d847d12f4896590de52824cb9, type: 2}
      text: No! I am not a cop! Calm down!
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: caacd43d847d12f4896590de52824cb9, type: 2}
      text: "I just wanted to let you know, you\u2019re putting yourself in danger..."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000}
      text: Sometimes you need to put yourself in danger if you want a proper life.
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "... Sit down, Steph. Let\u2019s all talk and I\u2019ll get you something
        to drink."
      effect: 0
      bonusGold: 0
    - speaker: {fileID: 11400000, guid: caacd43d847d12f4896590de52824cb9, type: 2}
      text: Fine...
      effect: 1
      bonusGold: 0
  - topicName: PONDERING + NO CHARISMA + HEALING
    requiredDay: 0
    requiredStoryFlags:
