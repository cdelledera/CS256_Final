  m_Name: Joe_Day1
  m_EditorClassIdentifier: 
  characterName: Joe
  companion: {fileID: 0}
  greetingTopic:
    topicName: 
    requiredLilyState: 0
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
    flagToSet: 
    lines: []
  availableTopics:
  - topicName: Your Order?
    requiredLilyState: 0
    requiredDay: 1
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: Hey bartender!
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: hey.
    - speaker: {fileID: 11400000}
      text: One lemonade please!
  - topicName: You seem enthusiastic
    requiredLilyState: 0
    requiredDay: 1
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: Your Order?
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: "well, it\u2019s almost a wonderful day."
    - speaker: {fileID: 11400000}
      text: Me and my wife are having our anniversary next week.
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: "\u201Coh well, that\u2019s nice. How did the two of you meet?\u201D "
    - speaker: {fileID: 11400000}
      text: oh well it was almost five years ago at this point.
    - speaker: {fileID: 11400000}
      text: "The two of us were at a mutual friend\u2019s housewarming\r\nparty"
    - speaker: {fileID: 11400000}
      text: ' We stood in the corner together chatting about all sorts of things.
        We had a drink bowl all to ourselves

        as well.'
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: what drink was it? Lemonade?
    - speaker: {fileID: 11400000}
      text: No, but it was similar. I usually drink lemonade to remember that night
        a little bit
    - speaker: {fileID: 11400000}
      text: The actual drink was pink and had a slightly suble taste to it.
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: I see...
  - topicName: So, what do you do?
    requiredLilyState: 0
    requiredDay: 1
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: Your Order?
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: "\u201CI\u2019m a berry farmer. I don\u2019t live all too far from this
        place..."
    - speaker: {fileID: 11400000}
      text: This place was a potion shop, right? I used to pass by it on my way to
        the general store
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Yeahhh... I got a little screwed over by the new birds in charge
    - speaker: {fileID: 11400000}
      text: "Well, at least mixing drinks and mixing potions ain\u2019t all that
        different, right?"
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: you could say that.
  conditionalReactions:
  - branchName: Pink Lemonade
    requiredPotions: 08000000
    requiredEffects: 
    requiredCategories: 
    goldReward: 300
    reactionTopic:
      topicName: This is it!
      requiredLilyState: 0
      requiredDay: 0
      requiredStoryFlag: 
      excludedStoryFlag: 
      requiredPreviousTopic: 
      flagToSet: Joe_Got_Pink
      lines:
      - speaker: {fileID: 11400000}
        text: This... no way...
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: It might not be what you wanted. Give it a shot.
      - speaker: {fileID: 11400000}
        text: "*sip* \u201CIt is! This is the drink! I remember it like it was yesterday..."
      - speaker: {fileID: 11400000}
        text: "What\u2019s it called?"
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: "... It\u2019s just pink lemonade..."
      - speaker: {fileID: 11400000}
        text: ...What?
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Yeah, it's lemonade but...pink and flavored up a little...
      - speaker: {fileID: 11400000}
        text: ... Well now I just feel silly. Either way, this is absolutely wonderful.
          Thank you so much!
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Really, don't mention it.
      - speaker: {fileID: 11400000}
        text: As a token of my appreciation, I want you to have this.
      - speaker: {fileID: 11400000}
        text: The best one of the harvest. I was going to eat it myself, but I think
          you earned it
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Thanks, Joe. You have a nice day.
  - branchName: Regular Order
    requiredPotions: 02000000
    requiredEffects: 
    requiredCategories: 
    goldReward: 150
    reactionTopic:
      topicName: Regular Order Given
      requiredLilyState: 0
      requiredDay: 0
      requiredStoryFlag: 
      excludedStoryFlag: 
      requiredPreviousTopic: 
      flagToSet: 
      lines:
      - speaker: {fileID: 11400000}
        text: Thanks! This is real nice!
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: "It\u2019s just lemonade, I\u2019m not sure how much you should be
          congratulating me here..."
      - speaker: {fileID: 11400000}
        text: Still, you make it well. I might come back another time.
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Alright. You have a nice day.
  defaultFailReaction:
    topicName: Fail
    requiredLilyState: 0
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
    flagToSet: 
    lines:
    - speaker: {fileID: 11400000}
      text: ... This is not at all what I ordered...
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Oh...sorry.
    - speaker: {fileID: 11400000}
      text: Could you take it back?
    - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
      text: Fine...
