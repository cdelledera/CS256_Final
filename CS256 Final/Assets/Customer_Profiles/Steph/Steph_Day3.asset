        effect: 0
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: You have a nice day.
        effect: 0
  - branchName: Dragon Fruit
    requiredPotions: 05000000
    requiredEffects: 
    requiredFlavors: 
    goldReward: 250
    reactionTopic:
      topicName: 
      requiredDay: 0
      requiredStoryFlag: 
      excludedStoryFlag: 
      requiredPreviousTopic: 
      flagToSet: 
      lines:
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: "Here, short of just giving you a glass of water, this is the closest
          I\u2019ve got to a healing potion."
        effect: 0
      - speaker: {fileID: 11400000}
        text: "... Well, it\u2019s pretty good. I appreciate it."
        effect: 0
      - speaker: {fileID: 11400000, guid: a117d69041774e64883c4a1f3ddec85b, type: 2}
        text: Any time, come back soon.
        effect: 0
      - speaker: {fileID: 11400000}
        text: I will.
        effect: 0
  defaultFailReaction:
    topicName: Default
    requiredDay: 0
    requiredStoryFlag: 
    excludedStoryFlag: 
    requiredPreviousTopic: 
